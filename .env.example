# Скопируйте этот файл в файл с именем .env и заполните реальными значениями.
# Файл .env НЕ должен попадать в Git — он уже добавлен в .gitignore.
# Если вы не программист: просто создайте рядом файл ".env" (без .example
# в конце) и заполните значения после знака "=" — без пробелов и без кавычек.

# Токен Telegram-бота. Получить его можно у @BotFather в Telegram:
# напишите ему /newbot и следуйте инструкциям.
BOT_TOKEN=

# Ключ доступа к российскому ИИ-прокси (например, vsegpt.ru), через который
# бот обращается к ИИ-моделям для генерации текста и расшифровки голоса.
AI_PROXY_API_KEY=

# Telegram chat id владельца бота — сюда бот будет присылать уведомления
# об ошибках и падениях. Узнать свой chat id можно, написав боту @userinfobot.
OWNER_CHAT_ID=

# Сколько запросов на генерацию контента разрешено одному пользователю в день.
# Необязательно, по умолчанию 20.
DAILY_LIMIT=20

# Сколько запросов на генерацию контента разрешено одному пользователю в месяц.
# Необязательно, по умолчанию 300.
MONTHLY_LIMIT=300

# Час (0-23, по московскому времени), в который бот ежедневно присылает
# дайджест новостей по сохранённой теме. Необязательно, по умолчанию 9.
DIGEST_SEND_HOUR=9

# Путь к файлу базы данных SQLite (создастся автоматически при первом запуске).
# Необязательно, по умолчанию bot.db.
DB_PATH=bot.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR.
# Для обычной работы достаточно INFO. Необязательно, по умолчанию INFO.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# ВЫБОР ИИ-ПРОВАЙДЕРА
#
# Бот работает с любым OpenAI-совместимым прокси. Проверены два, и они
# требуют РАЗНЫХ названий моделей — меняйте блок целиком, а не по одной
# строке. Замеры цен и сравнение — в dengi.md.
#
# Вариант 1 — openrouter.ai (дешевле в 2-5 раз, оплата в долларах: карты РФ
# не работают, пополнение криптой USDC):
#
#   AI_PROXY_BASE_URL=https://openrouter.ai/api/v1
#   AI_GATEWAY_PROVIDER=openrouter
#   AI_GATEWAY_TEXT_MODEL=openai/gpt-4o-mini
#   AI_GATEWAY_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
#   AI_GATEWAY_IMAGE_MODEL=openai/gpt-5-image-mini
#   AI_GATEWAY_PREMIUM_IMAGE_MODEL=openai/gpt-5-image
#
# Вариант 2 — vsegpt.ru (дороже, зато оплата рублями с карты РФ) — значения
# ниже по умолчанию. У него у моделей распознавания речи приставка "stt-",
# у openrouter.ai её нет.
#
# Название провайдера важно не только для логов: от него зависит, как бот
# спрашивает остаток на счёте (у openrouter.ai это /credits и разница
# total_credits - total_usage, у vsegpt.ru — /balance).
# ---------------------------------------------------------------------------

# Адрес ИИ-прокси (OpenAI-совместимый API).
# Необязательно, по умолчанию https://api.vsegpt.ru/v1.
AI_PROXY_BASE_URL=https://api.vsegpt.ru/v1

# Название провайдера: vsegpt или openrouter.
# Необязательно, по умолчанию vsegpt.
AI_GATEWAY_PROVIDER=vsegpt

# Модель для генерации текста. Необязательно, по умолчанию openai/gpt-4o-mini.
AI_GATEWAY_TEXT_MODEL=openai/gpt-4o-mini

# Модель для расшифровки голосовых сообщений. Необязательно, по умолчанию
# stt-openai/gpt-4o-mini-transcribe — 0.96 ₽ за минуту аудио против 1.20 ₽ у
# stt-openai/whisper-1 (vsegpt.ru считает 1 токен = 1 секунда аудио, цена в
# каталоге дана за 1000 токенов). Расход списывается с баланса счёта по факту:
# тариф "Базовый"/"Профессиональный" снимает лимиты на частоту запросов, но
# использование API не оплачивает. Подробнее — dengi.md.
AI_GATEWAY_TRANSCRIPTION_MODEL=stt-openai/gpt-4o-mini-transcribe

# Модель для генерации картинок. Необязательно, по умолчанию бюджетная
# img-flux/flux-2-klein-4b (dall-e-3 из документации vsegpt.ru временно
# заблокирована самим OpenAI). Есть более реалистичная img-flux/pro1.1
# (FLUX1.1 Pro), но она стоит ~15₽ за картинку с баланса счёта (отдельно
# от тарифа "Профессиональный", который сам по себе usage не оплачивает) —
# включайте её осознанно, если готовы к расходу.
AI_GATEWAY_IMAGE_MODEL=img-flux/flux-2-klein-4b

# Размер генерируемой картинки. Необязательно, по умолчанию 1024x1024.
AI_GATEWAY_IMAGE_SIZE=1024x1024

# Модель для кнопки "Сделать реалистичнее" под уже сгенерированной картинкой.
# Необязательно, по умолчанию img-flux/pro1.1 (FLUX1.1 Pro, ~15₽/картинку —
# отдельно от тарифа "Профессиональный", списывается с баланса счёта).
AI_GATEWAY_PREMIUM_IMAGE_MODEL=img-flux/pro1.1

# --- RUNWARE: картинки и тексты отдельно от основного прокси ---------------
#
# Провайдер выбирается на операцию. Смысл в том, что ни один провайдер не
# закрывает всё: у Runware картинка стоит 0.06 ₽ против 3.90 ₽ у vsegpt, но
# распознавания речи у Runware нет вовсе (проверено живыми запросами
# 04.08.2026 — есть тип задачи, но нет ни одной модели), поэтому голос обязан
# остаться на vsegpt.
#
# Пустые/незаданные значения означают "как основной провайдер", то есть по
# умолчанию ничего не меняется и бот работает как раньше.
#
# Рекомендуемая расстановка:
#   IMAGE_PROVIDER=runware
#   TEXT_PROVIDER=runware
#   (расшифровка остаётся на vsegpt — отдельной настройки для неё нет)
IMAGE_PROVIDER=
TEXT_PROVIDER=

# За чьим счётом следит предупреждение о низком балансе. Пусто — за основным
# провайдером. Ставьте того, у кого реально тратятся деньги: следить за
# счётом, с которого ничего не списывается, значит получать тревогу впустую.
#   BALANCE_PROVIDER=runware
BALANCE_PROVIDER=

# Ключ Runware: личный кабинет runware.ai → API Keys. Показывается один раз
# при создании, потом маскируется — сохраните сразу. Минимальное пополнение
# счёта у них $20.
RUNWARE_API_KEY=

# Адрес и модели Runware. Необязательно, значения по умолчанию:
#   RUNWARE_BASE_URL=https://api.runware.ai/v1
#   RUNWARE_IMAGE_MODEL=runware:100@1          FLUX.1 Schnell, 0.06 ₽
#   RUNWARE_PREMIUM_IMAGE_MODEL=runware:101@1  FLUX.1 Dev, 0.12 ₽
#   RUNWARE_TEXT_MODEL=deepseek-v4-flash       ~0.002 ₽ за пост
#
# Про модели текста: `qwen3.5-4b` кладёт ответ в поле `reasoning`, а не
# `content`, а модели `gpt-5*` отвергают параметр `max_tokens` — обе особенности
# проверены живыми запросами. `deepseek-v4-flash` свободна от обеих.
RUNWARE_BASE_URL=
RUNWARE_IMAGE_MODEL=
RUNWARE_PREMIUM_IMAGE_MODEL=
RUNWARE_TEXT_MODEL=

# --- РАСПОЗНАВАНИЕ РЕЧИ НА СВОЁМ СЕРВЕРЕ ------------------------------------
#
# TRANSCRIPTION_PROVIDER=local включает faster-whisper прямо на сервере:
# голосовые перестают стоить за минуту и не зависят ни от какого сервиса.
# Пусто — расшифровка идёт через основной ИИ-прокси, как раньше.
#
# Требует ffmpeg на сервере (он и так нужен для кружочков) и около 700 МБ
# свободной памяти на время расшифровки. Модель скачивается сама при первом
# запуске (~460 МБ) и кладётся в ~/.cache/huggingface.
TRANSCRIPTION_PROVIDER=

# Модель распознавания. Необязательно, по умолчанию small.
#
# НЕ ставьте base: на живой записи владельца (05.08.2026) она расслышала
# "Создай мне пост" как "Создание пуст" — то есть потеряла саму команду.
# small на той же записи расшифровала фразу верно: 3.2 с работы на 15.7 с
# речи, 698 МБ пика памяти. medium точнее small, но просит около 1.5 ГБ и
# на сервере с 2 ГБ рискует убить бота нехваткой памяти.
LOCAL_WHISPER_MODEL=

# Точность вычислений. Необязательно, по умолчанию int8 — единственный
# разумный вариант на процессоре без видеокарты.
LOCAL_WHISPER_COMPUTE_TYPE=

# Сколько раз повторять запрос к ИИ-прокси при таймауте/сбое сервера.
# Необязательно, по умолчанию 2.
AI_GATEWAY_MAX_RETRIES=2

# Сколько секунд ждать ответа от ИИ-прокси, прежде чем считать это таймаутом.
# Необязательно, по умолчанию 30.
AI_GATEWAY_TIMEOUT_SECONDS=30

# Сколько вариантов текста генерировать на каждую площадку (Telegram, VK).
# Необязательно, по умолчанию 2.
CONTENT_VARIANTS_COUNT=2

# ---------------------------------------------------------------------------
# Защита баланса AI-прокси (см. dengi.md). Всё необязательно.
# ---------------------------------------------------------------------------

# Максимальная длина голосового сообщения в секундах. Более длинные бот даже
# не скачивает — расшифровка тарифицируется по секундам аудио (0.96 ₽/мин),
# и одно 10-минутное голосовое стоит ~10 ₽. По умолчанию 180 (3 минуты).
MAX_VOICE_DURATION_SECONDS=180

# Сколько картинок в день может сгенерировать один пользователь. Картинки —
# 70–90% себестоимости (3.90 ₽ за flux-2-klein-4b, ~10–15 ₽ за pro1.1 против
# ~0.25 ₽ за текст поста). По умолчанию 3.
DAILY_IMAGE_LIMIT=3

# Баланс AI-прокси в рублях, ниже которого бот пишет владельцу предупреждение,
# и период проверки баланса в секундах. По умолчанию 50 ₽ и 3600 с (раз в час).
BALANCE_ALERT_THRESHOLD_RUB=50
BALANCE_CHECK_INTERVAL_SECONDS=3600

# Курс доллара к рублю для пересчёта. Нужен только с openrouter.ai, который
# считает в долларах: порог выше, отчёт /costs и оценки «хватит на N картинок»
# ведутся в рублях. Это грубая константа для предупреждений — по ней ничего
# не списывается. По умолчанию 92.
USD_RUB_RATE=92

# Ссылка на задеплоенный Mini App (веб-страницу), которую бот открывает
# внутри Telegram.
MINI_APP_URL=

# Настройки внутреннего веб-сервера, который отдаёт вашему сайту
# актуальный текст/фото карточки услуги (пилот, см. docs/superpowers/specs/
# 2026-07-24-site-sync-pilot-design.md). Необязательно, есть значения по
# умолчанию — трогать нужно только на реальном сервере, не на своём
# компьютере.
SITE_API_HOST=0.0.0.0
SITE_API_PORT=8080
SITE_MEDIA_DIR=site_media

# Клонирование голоса для фичи «двойник» (кружки). Пустое значение = фича выключена.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
TMP_MEDIA_DIR=tmp_media

# --- Говорящий двойник -------------------------------------------------
# Движок говорящего видео. Замеры 2026-08-06: klingai:avatar@2.0-standard —
# 270 ₽/мин, утверждён владельцем. Альтернативы и их цены — в
# docs/reference-video-avatar-engines.md.
AVATAR_PROVIDER=runware
AVATAR_MODEL=klingai:avatar@2.0-standard
# Модель правки образа по фотографии лица, 4 ₽ за картинку.
AVATAR_LOOK_MODEL=google:4@1
# Целевая длина кружка и жёсткий предел формата video note.
AVATAR_TARGET_SECONDS=30
AVATAR_MAX_SECONDS=60
# Потолок расхода на пользователя в секундах рендера за календарный месяц.
# 300 секунд — 10 кружков по 30 секунд, около 1350 ₽.
AVATAR_MONTHLY_SECONDS_LIMIT=300
# Как часто воркер опрашивает провайдера о готовности рендера.
AVATAR_POLL_INTERVAL_SECONDS=20
# Синтез речи клонированным голосом. Пока ключа ElevenLabs нет, оставить
# выключенным: написанный текст будет отдаваться суфлёром.
AVATAR_VOICE_SYNTHESIS_ENABLED=0
