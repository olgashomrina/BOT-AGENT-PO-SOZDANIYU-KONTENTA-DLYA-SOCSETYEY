# Секреты и локальная конфигурация
.env
.env.*
!.env.example
*.env.bak
*.env.save

# База данных
*.db
*.db-journal

# Медиафайлы сайта, скачанные в рантайме (media_cache.cache_photo) —
# .gitkeep оставляем, чтобы папка существовала для aiohttp add_static
site_media/*
!site_media/.gitkeep

# Логи
logs/
*.log

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Виртуальное окружение
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# ОС
.DS_Store
Thumbs.db

# Локальные настройки Claude Code (личные, не для команды)
.claude/settings.local.json

# Локальные git worktree Claude Code (рабочие копии на диске, не для репозитория)
.claude/worktrees/
